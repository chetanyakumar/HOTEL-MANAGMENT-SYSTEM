PORT=3000

# Local MongoDB (recommended for development). Start mongod or use Docker first.
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_management

# MongoDB Atlas (paste your own URI from Atlas → Connect → Drivers — do not commit real passwords)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hotel_management

# If Atlas DNS fails on your machine, keep Atlas in MONGODB_URI above and set this to try local DB after failure:
# MONGODB_LOCAL_FALLBACK=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
